{{/* gotype: entgo.io/ent/entc/gen.Graph */}}

{{ define "data" }}

{{- range $node := $.Nodes }}
{{- range $field := $node.Fields }}
{{- $public := true }}
{{- with $access := $field.Annotations.Access }}{{ $public = not $access.Private }}{{ end -}}
{{- if and $field.IsEnum $public }}
export type {{ $node.Name }}{{ $field.StructField }}Enum = {{ range $enum := $field.Enums }}"{{ $enum.Value }}" | {{ end }}"";
{{ end -}}
{{ end -}}
{{ end -}}

{{ range $node := $.Nodes }}
export interface {{ $node.Name }}Data {
    {{ if $node.ID }}id: string,{{ end }}
    {{- range $field := $node.Fields }}
    {{- $public := true }}
    {{- with $access := $field.Annotations.Access }}{{ $public = not $access.Private }}{{ end }}
    {{- if $public }}
    {{- if or $field.Type.Type.Integer $field.Type.Type.Float }}{{ $field.Name }}: number{{ if $field.Nillable }}|null{{ end }},{{ end }}
    {{- if $field.IsString }}{{ $field.Name }}: string{{ if $field.Nillable }}|null{{ end }},{{ end }}
    {{- if $field.IsBool }}{{ $field.Name }}: boolean{{ if $field.Nillable }}|null{{ end }},{{ end }}
    {{- if $field.IsTime }}{{ $field.Name }}: string{{ if $field.Nillable }}|null{{ end }},{{ end }}
    {{- if $field.IsUUID }}{{ $field.Name }}: string{{ if $field.Nillable }}|null{{ end }},{{ end }}
    {{- if $field.IsEnum }}{{ $field.Name }}: {{ $node.Name }}{{ $field.StructField }}Enum{{ if $field.Nillable }}|null{{ end }},{{ end }}
    {{- if $field.IsJSON }}{{ $field.Name }}: object{{ if $field.Nillable }}|null{{ end }},{{ end }}
    {{ end -}}
    {{ end -}}
    {{- range $edge := $node.Edges }}
    {{- if not $edge.IsInverse }}
    {{- if or $edge.O2O $edge.M2O }}{{ $edge.Name }}?: {{ $edge.Type.Name }}Data,{{ end }}
    {{- if or $edge.O2M $edge.M2M }}{{ $edge.Name }}?: {{ $edge.Type.Name }}Data[],{{ end }}
    {{ end -}}
    {{ end -}}
}
{{ end }}

{{ end }}