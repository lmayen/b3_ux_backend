type PaginationOptions struct {
	PageOffset int `json:"page_offset" form:"page_offset"`
	PageLimit  int `json:"page_limit" form:"page_limit"`
}

{{ range $node := $.Nodes }}

func (q *{{ $node.QueryName }}) ApplyPaginationOptions(options *PaginationOptions) *{{ $node.QueryName }} {
    return q.Offset(options.PageOffset).Limit(options.PageLimit)
}

