{{/* gotype: entgo.io/ent/entc/gen.Graph */}}

{{ define "utils_sorting" }}

{{ template "header" $ }}

import (
    "entgo.io/ent/dialect/sql"

    {{ range $node := $.Nodes }}
    {{ $node.Package }} "{{ $.Config.Package }}/{{ $node.PackageDir }}"
    {{ end }}
)

type SortDirection string

const (
	SortDirectionAsc  SortDirection = "ASC"
	SortDirectionDesc SortDirection = "DESC"
)

type SortOptions struct {
	SortField     string        `json:"sort_field" form:"sort_field"`
	SortDirection SortDirection `json:"sort_direction" form:"sort_direction"`
}

func (s SortDirection) TermOption() sql.OrderTermOption {
	if s == SortDirectionAsc {
		return sql.OrderAsc()
	}

	return sql.OrderDesc()
}


{{ range $node := $.Nodes }}

func (q *{{ $node.QueryName }}) ApplySortingOptions(options *SortOptions) *{{ $node.QueryName }} {
    switch options.SortField {

    {{ if $node.ID }}
    case "id":
        q.Order({{ $node.Package }}.ByID(options.SortDirection.TermOption()))
    {{ end }}

    {{ range $field := $node.Fields }}
    {{ if not $field.IsJSON }}
    case "{{ $field.Name }}":
        q.Order({{ $node.Package }}.By{{ $field.StructField  }}(options.SortDirection.TermOption()))
    {{ end }}
    {{ end }}
    {{ if $node.ID }}
    default:
        q.Order({{ $node.Package }}.ByID(sql.OrderAsc()))
    {{ end }}
    }

    return q
}

{{ end }}

{{ end }}